# Template for backend/.env. Copy to .env and fill in values.
# Never commit .env or real tokens. Optional values below show their defaults.

# Required: Databricks workspace URL (HTTPS outside localhost).
DATABRICKS_HOST=https://<workspace>.cloud.databricks.com

# Local development only. Leave empty to use Databricks SDK default credentials.
# Prefer enterprise-approved workload identity in deployed environments.
DATABRICKS_TOKEN=

# Required when CATALOG_TAG_FILTER is set: SQL warehouse used to read catalog tags.
DATABRICKS_WAREHOUSE_ID=

# Comma-separated UC tag names; only catalogs with one of these tags are returned.
CATALOG_TAG_FILTER=gpdip,gpdip_dev,gpdip_stg,gpdip_prod

# Comma-separated frontend origins allowed by CORS.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Tuning (optional)
DISCOVERY_CACHE_TTL_SECONDS=300
DISCOVERY_CACHE_MAX_ENTRIES=500
DATABRICKS_PAGE_SIZE=500
DATABRICKS_TIMEOUT_SECONDS=30.0
DISCOVERY_MAX_SCHEMA_REQUESTS=5
